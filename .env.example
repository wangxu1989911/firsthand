# Configuration only ever arrives through environment variables (design doc §8.3).
# Copy to .env for local runs outside Compose; Compose sets these itself.
FIRSTHAND_DATABASE_URL=postgresql://firsthand:firsthand@localhost:5432/firsthand
FIRSTHAND_REDIS_URL=redis://localhost:6379/0
FIRSTHAND_EMBEDDING_DIMENSIONS=1536
FIRSTHAND_STATE_TTL_SECONDS=86400
FIRSTHAND_PORT=8080
FIRSTHAND_LOG_LEVEL=INFO

# Bind address for the HTTP server.
FIRSTHAND_HOST=0.0.0.0

# Postgres connection pool bounds (min must not exceed max).
FIRSTHAND_POOL_MIN_SIZE=1
FIRSTHAND_POOL_MAX_SIZE=10

# Socket timeout for the Redis client; without one a half-open socket hangs
# the readiness probe instead of failing it.
FIRSTHAND_REDIS_TIMEOUT_SECONDS=5.0

# The LLM provider — the one call that leaves the box (design doc §8.6). Tests
# never read these; they inject recorded fixtures. Leave the key empty until
# there is a real provider to talk to.
FIRSTHAND_LLM_BASE_URL=https://api.openai.com/v1
FIRSTHAND_LLM_API_KEY=
FIRSTHAND_LLM_CHAT_MODEL=gpt-4o-mini
FIRSTHAND_LLM_EMBEDDING_MODEL=text-embedding-3-small
FIRSTHAND_LLM_TIMEOUT_SECONDS=30.0
FIRSTHAND_LLM_MAX_RETRIES=2

# Phase 2 — web chat + admin area.
# Master key for encrypting connector credentials at rest and signing admin
# session cookies (§8.7). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The public chat boots without it; every admin/connector path requires it.
FIRSTHAND_SECRET_KEY=
FIRSTHAND_ADMIN_SESSION_TTL_SECONDS=43200
# Optional: path to a JSON eval report the dashboard should surface.
FIRSTHAND_EVAL_REPORT_PATH=
